{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prd.contract.json — PRD가 Plan·TC에 넘기는 기계 계약 (코드·스택 무관)",
  "type": "object",
  "required": ["feature", "screens", "acs", "impl_requirements", "non_goals"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string", "description": "기능/업무영역 식별자" },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["screen_id", "title", "components"],
        "additionalProperties": false,
        "properties": {
          "screen_id": { "type": "string", "description": "화면 식별자 (예 A-18)" },
          "title": { "type": "string" },
          "purpose": { "type": "string" },
          "entry": { "type": "string", "description": "도달 경로 서술(스택 무관)" },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["key", "kind", "label"],
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z]+-[a-z0-9-]+$", "description": "{kind}-{name} 논리 식별자. 셀렉터 아님" },
                "kind": { "enum": ["grid", "button", "search", "modal", "field", "link", "tab", "badge", "list", "text"] },
                "label": { "type": "string", "description": "실제 표시 텍스트" },
                "role": { "type": "string" },
                "columns": { "type": "array", "items": { "type": "string" } },
                "opens": { "type": "string", "description": "여는 컴포넌트 key" },
                "behavior": { "type": "string", "description": "관측가능 반응" }
              }
            }
          }
        }
      }
    },
    "acs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "screen_id", "layer", "given", "when", "then"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[A-Z][A-Z0-9]*(?:-[0-9]+)*-[0-9]{2}$" },
          "screen_id": { "type": "string" },
          "layer": { "enum": ["render", "interaction", "flow"] },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string" }, "description": "참조 컴포넌트 key" }
        }
      }
    },
    "impl_requirements": {
      "type": "object",
      "description": "req#8 — 코드 없음·스택 미정 전제의 구현 명세. 코드·프레임워크명·파일경로 금지",
      "required": ["frontend"],
      "additionalProperties": false,
      "properties": {
        "frontend": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "backend": { "type": "array", "items": { "type": "string" } }
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "§6 비목표 — 이번 구현에서 제외하는 항목(스코프 경계). Plan·TC가 이를 다루면 창작"
    },
    "unknowns": {
      "type": "array",
      "description": "U-xxx 원장 — 근거가 없으면 추측으로 채우지 않고 남긴다. blocking=true 는 게이트 REVIEW_REQUIRED(사람 결정 대기)",
      "items": {
        "type": "object",
        "required": ["id", "unknown", "impact", "blocking"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^U-[0-9]{3}$" },
          "area": { "type": "string", "description": "관련 화면/영역 (예 A-18)" },
          "unknown": { "type": "string", "description": "무엇이 미확인인가" },
          "impact": { "type": "string", "description": "미결 시 영향 (예: AC-A18-03 then 확정 불가)" },
          "blocking": { "type": "boolean", "description": "true = 다음 단계 진행 전 사람 결정 필요" },
          "required_decision": { "type": "string", "description": "필요한 결정(선택지)" }
        }
      }
    }
  }
}
