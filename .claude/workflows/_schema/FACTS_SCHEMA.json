{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FACTS_{feature}.json — PRD 이전 사실확인·확신도 자가평가 + 질문지 (Human Gate)",
  "$comment": "게이트 산식(gate_check.py gate_facts가 기계 검증): overall_confidence<0.75 OR 임의 screens[].confidence<0.70 OR severity=blocking인 issue가 1건 이상 존재 → human_gate_required=true 여야 함. blocking issue는 questions[].source_issue로 최소 1개 참조돼야 함(고아 blocking issue = FAIL). approved:true는 questions[] 전부에 answer가 채워진 뒤에만 허용.",
  "type": "object",
  "required": ["feature", "screens", "overall_confidence", "human_gate_required", "questions", "approved"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string" },
    "source_brief": { "type": "string", "description": "기획서 브리프 원문 위치/요약(근거 추적용)" },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["screen_ref", "title", "confidence", "confidence_reason", "issues"],
        "additionalProperties": false,
        "properties": {
          "screen_ref": {
            "type": "string",
            "description": "임시 라벨 — PRD screen_id(A-18 등)와 기계적 1:1 아님. PRD 단계가 정식 screen_id를 부여한다."
          },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "confidence": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.0,
            "description": "브리프 근거의 명확도 자가평가. 1.0=전부 명시, 0.5=대부분 추정 필요"
          },
          "confidence_reason": { "type": "string" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "detail", "severity"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^ISSUE-[0-9]+$" },
                "detail": { "type": "string" },
                "severity": { "enum": ["blocking", "minor"] },
                "resolved": { "type": "boolean" },
                "resolution": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "overview_issues": {
      "type": "array",
      "items": { "type": "string" },
      "description": "화면 단위로 묶이지 않는 전체 이슈(용어 충돌·전제 불명 등)"
    },
    "overall_confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
    "human_gate_required": { "type": "boolean" },
    "questions": {
      "type": "array",
      "description": "AskUserQuestion 파라미터와 1:1 대응 — Main이 그대로 전달한다.",
      "items": {
        "type": "object",
        "required": ["question", "header", "options"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "header": { "type": "string", "maxLength": 12 },
          "multiSelect": { "type": "boolean" },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["label"],
              "properties": {
                "label": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "source_issue": { "type": "string", "description": "이 질문이 해소하려는 issues[].id" },
          "answer": {
            "type": "object",
            "properties": {
              "selected": { "type": "array", "items": { "type": "string" } },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "approved": { "type": "boolean" },
    "approved_at": { "type": "string" }
  }
}
