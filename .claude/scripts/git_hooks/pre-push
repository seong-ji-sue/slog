#!/bin/bash
# develop push gate — requires explicit user approval token
# Token file: .git/PUSH_APPROVED  (created by main Claude only after user says "승인")
# Token is consumed (deleted) on successful pass.

remote="$1"
url="$2"

while read local_ref local_sha remote_ref remote_sha; do
  # Only gate develop branch pushes
  if [[ "$remote_ref" == "refs/heads/develop" || "$remote_ref" == "refs/heads/master" || "$remote_ref" == "refs/heads/main" ]]; then
    GIT_DIR=$(git rev-parse --git-common-dir 2>/dev/null)
    TOKEN="$GIT_DIR/PUSH_APPROVED"

    if [[ ! -f "$TOKEN" ]]; then
      echo "" >&2
      echo "🚫 develop push 차단 — 사용자 승인 토큰 없음" >&2
      echo "" >&2
      echo "   절차:" >&2
      echo "   1. 사용자에게 push 승인 요청" >&2
      echo "   2. 사용자가 '승인' 응답" >&2
      echo "   3. Main Claude가 토큰 생성: touch \$(git rev-parse --git-common-dir)/PUSH_APPROVED" >&2
      echo "   4. git push 재실행" >&2
      echo "" >&2
      exit 1
    fi

    # Token found — consume it and allow push
    rm -f "$TOKEN"
    echo "✅ 사용자 승인 확인 — develop push 허용" >&2
  fi
done

exit 0
